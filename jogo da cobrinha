ArrayList<Integer> x = new ArrayList<Integer>(), y = new ArrayList<Integer>();
int[] dx = {0, 0, 1, -1}, dy = {1, -1, 0, 0};

int w = 30, h = 30, bs = 20, dir = 2;
int applex = 12, appley = 10;
int newdir = 0;

int score = 0;
int state = 0;
float s = 0;

boolean gameover = false;

void setup() {
  size(600, 600);
  smooth(2);
  
  x.add(5);
  y.add(5);
}

void draw() {
  background(0);
  frameRate(60);
  
  if(state == 0) {
    s += 0.25;
    if(s > 10) s = 0;
    
    fill(255);
    textAlign(CENTER);
    textSize(40);
    text("JOGO DA COBRINHA", width/2, height/2 - 100);
    
    fill(50, 190, 70);
    rect(width/2 - 130 - s/2, height/2 - 30 - s/2, 260 + s, 60 + s, 10);
    
    textSize(30);
    fill(0);
    text("JOGAR", width/2, height/2 + 10);
    
    if (mousePressed && mouseX > width/2 - 130 && mouseX < width/2 + 130 &&
        mouseY > height/2 - 30 && mouseY < height/2 + 30) {
      state++;
    }
  }
  
  else if(state > 0) {
    snake();
  }
}

void snake() {
  background(0);
  
  for(int i = 0; i < w; i++) line(i*bs, 0, i*bs, height);
  for(int i = 0; i < h; i++) line(0, i*bs, width, i*bs);
  for(int i = 0; i < x.size(); i++) {
    fill(0, 255, 0);
    rect(x.get(i)*bs, y.get(i)*bs, bs, bs);
  }
  
  fill(50, 190, 70);
  textSize(20);
  text("SCORE:", 50, 42);
  text(score, 105, 42);
  
  if(!gameover) {
    fill(255, 0, 0);
    rect(applex*bs, appley*bs, bs, bs);
    
    if(frameCount % 6 == 0) {  // <-- VELOCIDADE AJUSTADA AQUI
      x.add(0, x.get(0) + dx[dir]);
      y.add(0, y.get(0) + dy[dir]);
      
      if(x.get(0) < 0 || y.get(0) < 0 || x.get(0) >= w || y.get(0) >= h)
        gameover = true;
      
      for(int i = 1; i < x.size(); i++)
        if(x.get(0) == x.get(i) && y.get(0) == y.get(i)) gameover = true;
      
      if(x.get(0) == applex && y.get(0) == appley) {
        applex = (int)random(0, w);
        appley = (int)random(0, h);
        score++;
      } else {
        x.remove(x.size() - 1);
        y.remove(y.size() - 1);
      }
    }
  } else {
    fill(50, 190, 70);
    textSize(50);
    textAlign(CENTER);
    text("GAME OVER", width/2, height/2 - 80);
    
    textSize(20);
    text("Score:", width/2 - 15, height/2 - 50);
    text(score, width/2 + 25, height/2 - 50);
    
    text("PRESSIONE ESPAÇO PARA JOGAR DE NOVO", width/2, height/2 + 10);
    text("PRESSIONE ESC PARA SAIR", width/2, height/2 + 60);
    
    if(keyPressed && key == ' '){
      x.clear();
      y.clear();
      
      x.add(5);
      y.add(5);
      
      gameover = false;
      score = 0;
      state = 0;
    }
  }
}

void keyPressed() {
  int newdir = key=='s' ? 0 : (key=='w' ? 1 : (key=='d' ? 2 : (key=='a' ? 3 : -1)));
  if (newdir != -1 && (x.size() <= 1 || !(x.get(1) == x.get(0) +
  dx[newdir] && y.get(1) == y.get(0) + dy[newdir]))) dir = newdir;
}
